<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="Create your personal portfolio page and share your links with the world.">
    <meta property="og:title" content="<%= appName %> - Create Your Personal Portfolio Page">
    <meta property="og:description" content="Build your portfolio, share your links, showcase your work.">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .gradient-text { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .gradient-bg-2 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .hero-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); }
        .glass { background: rgba(255,255,255,0.08); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.15); }
        .glow { box-shadow: 0 0 40px rgba(102,126,234,0.3); }
        .float-animation { animation: float 6s ease-in-out infinite; }
        .float-animation-delay { animation: float 6s ease-in-out infinite; animation-delay: -3s; }
        @keyframes float { 0%,100% { transform: translateY(0px); } 50% { transform: translateY(-20px); } }
        @keyframes blob { 0% { transform: translate(0px, 0px) scale(1); } 33% { transform: translate(30px, -50px) scale(1.1); } 66% { transform: translate(-20px, 20px) scale(0.9); } 100% { transform: translate(0px, 0px) scale(1); } }
        .animate-blob { animation: blob 7s infinite; }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }
        .feature-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .feature-card:hover { transform: translateY(-8px); }
        .shine { position: relative; overflow: hidden; }
        .shine::after { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: linear-gradient(to bottom right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0) 100%); transform: rotate(30deg); transition: all 0.6s; }
        .shine:hover::after { left: 100%; }
    </style>
</head>
<body class="min-h-screen bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors duration-300">

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 bg-white/80 dark:bg-gray-950/80 backdrop-blur-xl border-b border-gray-200/50 dark:border-gray-800/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <a href="/" class="flex items-center space-x-2">
                    <div class="w-8 h-8 gradient-bg rounded-lg flex items-center justify-center">
                        <i class="fas fa-rocket text-white text-sm"></i>
                    </div>
                    <span class="text-xl font-bold text-gray-900 dark:text-white"><%= appName %></span>
                </a>
                <div class="flex items-center space-x-3">
                    <button @click="darkMode = !darkMode; localStorage.setItem('darkMode', darkMode)" class="w-10 h-10 rounded-xl flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200">
                        <i x-show="!darkMode" class="fas fa-moon text-gray-500 text-lg"></i>
                        <i x-show="darkMode" class="fas fa-sun text-yellow-400 text-lg"></i>
                    </button>
                    <% if (user) { %>
                        <% if (user.role === 'admin') { %>
                            <a href="/admin" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition text-sm font-medium"><i class="fas fa-shield-halved mr-1"></i>Admin</a>
                        <% } %>
                        <a href="/dashboard" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-indigo-600 transition">Dashboard</a>
                        <form action="/logout" method="POST" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="text-sm font-medium text-gray-500 hover:text-red-500 transition">Logout</button>
                        </form>
                    <% } else { %>
                        <a href="/login" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition">Login</a>
                        <a href="/register" class="gradient-bg text-white px-5 py-2 rounded-xl text-sm font-semibold hover:shadow-lg hover:shadow-indigo-500/25 transition-all duration-200">Sign Up Free</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
        <!-- Animated Background Blobs -->
        <div class="absolute top-20 -left-40 w-80 h-80 bg-purple-300 dark:bg-purple-900/50 rounded-full mix-blend-multiply dark:mix-blend-normal filter blur-3xl opacity-50 animate-blob"></div>
        <div class="absolute top-40 -right-40 w-80 h-80 bg-indigo-300 dark:bg-indigo-900/50 rounded-full mix-blend-multiply dark:mix-blend-normal filter blur-3xl opacity-50 animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-20 left-1/3 w-80 h-80 bg-pink-300 dark:bg-pink-900/50 rounded-full mix-blend-multiply dark:mix-blend-normal filter blur-3xl opacity-50 animate-blob animation-delay-4000"></div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
            <div class="text-center">
                <div class="inline-flex items-center px-4 py-2 rounded-full bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-800 mb-8">
                    <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
                    <span class="text-sm font-medium text-indigo-700 dark:text-indigo-300">Now live — Join thousands of creators</span>
                </div>
                <h1 class="text-5xl sm:text-6xl lg:text-8xl font-black tracking-tight leading-tight">
                    Build Your<br>
                    <span class="gradient-text">Digital Identity</span>
                </h1>
                <p class="mt-8 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
                    Create a stunning portfolio page, share your links, showcase your work, and grow your audience — all in one beautiful link.
                </p>
                <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/register" class="group gradient-bg text-white px-8 py-4 text-lg font-semibold rounded-2xl hover:shadow-2xl hover:shadow-indigo-500/30 transition-all duration-300 flex items-center justify-center">
                        Start for Free
                        <i class="fas fa-arrow-right ml-3 group-hover:translate-x-1 transition-transform"></i>
                    </a>
                    <a href="/tousif" class="px-8 py-4 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-lg font-semibold rounded-2xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-200 border border-gray-200 dark:border-gray-700 flex items-center justify-center">
                        <i class="fas fa-play mr-3 text-sm"></i>
                        See Demo
                    </a>
                </div>
                <p class="mt-6 text-sm text-gray-400 dark:text-gray-500 flex items-center justify-center">
                    <i class="fas fa-link mr-2 text-xs"></i> droplaunch.dev/<span class="font-semibold text-gray-600 dark:text-gray-400">yourname</span>
                </p>
            </div>

            <!-- Preview Mockup -->
            <div class="mt-20 relative max-w-4xl mx-auto">
                <div class="absolute inset-0 gradient-bg rounded-3xl blur-3xl opacity-20"></div>
                <div class="relative bg-white dark:bg-gray-900 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-2xl p-1">
                    <div class="flex items-center space-x-2 px-4 py-3 border-b border-gray-100 dark:border-gray-800">
                        <div class="w-3 h-3 rounded-full bg-red-400"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                        <div class="w-3 h-3 rounded-full bg-green-400"></div>
                        <div class="flex-1 mx-4">
                            <div class="bg-gray-100 dark:bg-gray-800 rounded-lg px-4 py-1.5 text-sm text-gray-400 text-center">droplaunch.dev/tousif</div>
                        </div>
                    </div>
                    <div class="p-8 text-center">
                        <div class="w-20 h-20 gradient-bg rounded-full mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-user text-white text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Tousif Ahmad</h3>
                        <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">Full Stack Developer & Designer</p>
                        <div class="flex justify-center space-x-3 mt-4">
                            <div class="w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center"><i class="fab fa-github text-gray-600 dark:text-gray-400"></i></div>
                            <div class="w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center"><i class="fab fa-linkedin text-gray-600 dark:text-gray-400"></i></div>
                            <div class="w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center"><i class="fab fa-twitter text-gray-600 dark:text-gray-400"></i></div>
                        </div>
                        <div class="mt-6 space-y-3 max-w-sm mx-auto">
                            <div class="w-full py-3 px-6 bg-indigo-600 text-white rounded-xl text-sm font-medium">My Portfolio</div>
                            <div class="w-full py-3 px-6 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl text-sm font-medium border border-gray-200 dark:border-gray-700">GitHub Projects</div>
                            <div class="w-full py-3 px-6 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl text-sm font-medium border border-gray-200 dark:border-gray-700">Latest Blog</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Trusted By Section -->
    <section class="py-16 border-t border-gray-100 dark:border-gray-800/50">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-sm font-medium text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-8">Trusted by creators worldwide</p>
            <div class="flex flex-wrap justify-center items-center gap-12 opacity-50">
                <div class="flex items-center space-x-2 text-gray-400"><i class="fas fa-users text-2xl"></i><span class="text-lg font-semibold">500+ Users</span></div>
                <div class="flex items-center space-x-2 text-gray-400"><i class="fas fa-eye text-2xl"></i><span class="text-lg font-semibold">50K+ Views</span></div>
                <div class="flex items-center space-x-2 text-gray-400"><i class="fas fa-link text-2xl"></i><span class="text-lg font-semibold">10K+ Links</span></div>
                <div class="flex items-center space-x-2 text-gray-400"><i class="fas fa-globe text-2xl"></i><span class="text-lg font-semibold">30+ Countries</span></div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-24 bg-gray-50 dark:bg-gray-900/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20">
                <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">Features</span>
                <h2 class="mt-4 text-4xl sm:text-5xl font-bold">Everything You Need</h2>
                <p class="mt-4 text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">Powerful features to build and grow your online presence</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <% const features = [
                    { icon: 'fa-user', title: 'Custom Profile', desc: 'Personalized portfolio page with your own URL', color: 'from-blue-500 to-indigo-600' },
                    { icon: 'fa-link', title: 'Link Management', desc: 'Add, organize, and track all your important links', color: 'from-indigo-500 to-purple-600' },
                    { icon: 'fa-palette', title: '8 Themes', desc: 'Choose from 8 beautiful themes to match your style', color: 'from-purple-500 to-pink-600' },
                    { icon: 'fa-chart-line', title: 'Analytics', desc: 'Track profile views and link clicks with charts', color: 'from-pink-500 to-rose-600' },
                    { icon: 'fa-star', title: 'Spotlight CTA', desc: 'Prominent call-to-action button on your profile', color: 'from-amber-500 to-orange-600' },
                    { icon: 'fa-envelope', title: 'Email Signature', desc: 'Generate professional email signatures', color: 'from-emerald-500 to-teal-600' },
                    { icon: 'fa-qrcode', title: 'QR Code', desc: 'Shareable QR code for your profile page', color: 'from-cyan-500 to-blue-600' },
                    { icon: 'fa-address-card', title: 'Contact Form', desc: 'Let visitors send you messages directly', color: 'from-violet-500 to-indigo-600' },
                    { icon: 'fa-quote-left', title: 'Testimonials', desc: 'Showcase endorsements from clients', color: 'from-rose-500 to-pink-600' },
                    { icon: 'fa-file-alt', title: 'Resume/CV', desc: 'Display your education and experience', color: 'from-teal-500 to-emerald-600' },
                    { icon: 'fa-image', title: 'Hero Background', desc: 'Full-page background image on your profile', color: 'from-orange-500 to-amber-600' },
                    { icon: 'fa-images', title: 'Gallery & Videos', desc: 'Showcase your visual content beautifully', color: 'from-blue-500 to-cyan-600' },
                ]; features.forEach(f => { %>
                <div class="feature-card group p-6 bg-white dark:bg-gray-800/50 rounded-2xl border border-gray-200 dark:border-gray-800 hover:shadow-xl hover:shadow-indigo-500/5 transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br <%= f.color %> flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                        <i class="fas <%= f.icon %> text-white"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2"><%= f.title %></h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed"><%= f.desc %></p>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20">
                <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">How it works</span>
                <h2 class="mt-4 text-4xl sm:text-5xl font-bold">Get Started in 3 Steps</h2>
            </div>
            <div class="grid md:grid-cols-3 gap-12">
                <div class="text-center">
                    <div class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl font-bold">1</div>
                    <h3 class="text-xl font-bold mb-3">Create Account</h3>
                    <p class="text-gray-500 dark:text-gray-400">Sign up for free in seconds. No credit card required.</p>
                </div>
                <div class="text-center">
                    <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl font-bold">2</div>
                    <h3 class="text-xl font-bold mb-3">Customize Profile</h3>
                    <p class="text-gray-500 dark:text-gray-400">Add your links, choose a theme, and make it yours.</p>
                </div>
                <div class="text-center">
                    <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-rose-600 rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl font-bold">3</div>
                    <h3 class="text-xl font-bold mb-3">Share & Grow</h3>
                    <p class="text-gray-500 dark:text-gray-400">Share your link everywhere and track your growth.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section class="py-24 bg-gray-50 dark:bg-gray-900/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20">
                <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">Pricing</span>
                <h2 class="mt-4 text-4xl sm:text-5xl font-bold">Simple, Transparent Pricing</h2>
                <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">Start free. Upgrade when you need more power.</p>
            </div>
            <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                <!-- Free Plan -->
                <div class="relative p-8 bg-white dark:bg-gray-800/50 rounded-3xl border border-gray-200 dark:border-gray-800 hover:shadow-xl transition-all duration-300">
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Free</h3>
                    <p class="mt-2 text-gray-500 dark:text-gray-400">Perfect for getting started</p>
                    <div class="mt-6 flex items-baseline">
                        <span class="text-5xl font-black text-gray-900 dark:text-white">$0</span>
                        <span class="ml-2 text-gray-400">/forever</span>
                    </div>
                    <ul class="mt-8 space-y-4">
                        <li class="flex items-center text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-check w-5 h-5 text-green-500 mr-3"></i>Up to 5 links</li>
                        <li class="flex items-center text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-check w-5 h-5 text-green-500 mr-3"></i>2 Basic themes</li>
                        <li class="flex items-center text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-check w-5 h-5 text-green-500 mr-3"></i>Basic analytics</li>
                        <li class="flex items-center text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-check w-5 h-5 text-green-500 mr-3"></i>Spotlight CTA button</li>
                        <li class="flex items-center text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-check w-5 h-5 text-green-500 mr-3"></i>Email signature</li>
                        <li class="flex items-center text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-check w-5 h-5 text-green-500 mr-3"></i>QR code sharing</li>
                    </ul>
                    <a href="/register" class="mt-8 block text-center py-3.5 px-6 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-2xl font-semibold hover:bg-gray-200 dark:hover:bg-gray-600 transition-all duration-200">Get Started</a>
                </div>
                <!-- Premium Plan -->
                <div class="relative p-8 rounded-3xl gradient-bg text-white shadow-2xl shadow-indigo-500/25 hover:shadow-indigo-500/40 transition-all duration-300 shine">
                    <div class="absolute -top-4 right-8 bg-gradient-to-r from-amber-400 to-orange-500 text-white px-4 py-1.5 rounded-full text-xs font-bold shadow-lg"><i class="fas fa-crown mr-1"></i>POPULAR</div>
                    <h3 class="text-2xl font-bold">Premium</h3>
                    <p class="mt-2 text-indigo-200">Everything you need to grow</p>
                    <div class="mt-6 space-y-2">
                        <div class="flex items-baseline">
                            <span class="text-5xl font-black">$<%= premiumPriceUSD %></span>
                            <span class="ml-2 text-indigo-200">/USD per year</span>
                        </div>
                        <div class="flex items-baseline">
                            <span class="text-5xl font-black"><%= premiumPricePKR %></span>
                            <span class="ml-2 text-indigo-200">/PKR per year</span>
                        </div>
                    </div>
                    <ul class="mt-8 space-y-4">
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Unlimited links</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>All 8 premium themes</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Advanced analytics dashboard</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Contact form & messages</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Testimonials & Resume/CV</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Gallery & Videos</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Hero background image</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>SEO customization</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Remove branding</li>
                        <li class="flex items-center text-sm"><i class="fas fa-check w-5 h-5 text-yellow-300 mr-3"></i>Custom domain support</li>
                    </ul>
                    <a href="/register" class="mt-8 block text-center py-3.5 px-6 bg-white text-indigo-600 rounded-2xl font-bold hover:bg-gray-50 transition-all duration-200 shadow-lg">Upgrade Now <i class="fas fa-arrow-right ml-2"></i></a>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <div class="gradient-bg rounded-3xl p-12 md:p-16 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                <div class="absolute bottom-0 left-0 w-60 h-60 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
                <div class="relative">
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to Launch?</h2>
                    <p class="text-indigo-200 text-lg mb-8 max-w-xl mx-auto">Join thousands of creators who trust DropLaunch for their online presence.</p>
                    <a href="/register" class="inline-flex items-center px-8 py-4 bg-white text-indigo-600 text-lg font-bold rounded-2xl hover:bg-gray-50 transition-all duration-200 shadow-xl">
                        Create Your Page <i class="fas fa-rocket ml-3"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-50 dark:bg-gray-900/50 border-t border-gray-200 dark:border-gray-800/50 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="flex items-center space-x-2 mb-4 md:mb-0">
                    <div class="w-8 h-8 gradient-bg rounded-lg flex items-center justify-center">
                        <i class="fas fa-rocket text-white text-sm"></i>
                    </div>
                    <span class="font-bold text-gray-900 dark:text-white"><%= appName %></span>
                </div>
                <div class="flex space-x-8">
