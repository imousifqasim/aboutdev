<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profile.metaTitle || (user.name + ' | DropLaunch') %></title>
    <meta name="description" content="<%= profile.metaDescription || profile.bio || '' %>">
    <meta property="og:title" content="<%= profile.metaTitle || user.name %>">
    <meta property="og:description" content="<%= profile.metaDescription || profile.bio || '' %>">
    <% if (profile.ogImage) { %><meta property="og:image" content="/uploads/<%= profile.ogImage %>"><% } %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        .theme-default { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .theme-dark { background: #1a1a2e; color: #e0e0e0; }
        .theme-gradient { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .theme-minimal { background: #fafafa; color: #333; }
        .theme-bold { background: #dc2626; }
        .theme-ocean { background: linear-gradient(135deg, #667eea 0%, #06b6d4 100%); }
        .theme-sunset { background: linear-gradient(135deg, #f97316 0%, #ec4899 100%); }
        .theme-forest { background: linear-gradient(135deg, #059669 0%, #10b981 100%); }
    </style>
</head>
<body class="min-h-screen theme-<%= profile.theme %>">
    <% if (profile.backgroundImage) { %>
    <div class="fixed inset-0 z-0">
        <img src="/uploads/<%= profile.backgroundImage %>" class="w-full h-full object-cover" alt="Background">
        <div class="absolute inset-0 bg-black/50"></div>
    </div>
    <% } %>

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center py-12 px-4">
        <div class="max-w-lg w-full text-center">
            <!-- Profile Image -->
            <div class="mb-6">
                <% if (profile.image) { %>
                <img src="/uploads/<%= profile.image %>" alt="<%= user.name %>" class="w-28 h-28 rounded-full mx-auto object-cover border-4 border-white/30 shadow-xl">
                <% } else { %>
                <div class="w-28 h-28 rounded-full mx-auto bg-white/20 flex items-center justify-center border-4 border-white/30 shadow-xl">
                    <span class="text-4xl font-bold text-white"><%= user.name.charAt(0) %></span>
                </div>
                <% } %>
            </div>

            <!-- Name & Bio -->
            <h1 class="text-3xl font-bold <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                <%= user.name %>
            </h1>
            <% if (profile.bio) { %>
            <p class="mt-2 text-lg <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/80' : 'text-gray-600' %>">
                <%= profile.bio %>
            </p>
            <% } %>

            <% if (profile.location || profile.company) { %>
            <p class="mt-2 text-sm <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/60' : 'text-gray-500' %>">
                <% if (profile.location) { %><i class="fas fa-map-marker-alt mr-1"></i><%= profile.location %><% } %>
                <% if (profile.location && profile.company) { %> &bull; <% } %>
                <% if (profile.company) { %><i class="fas fa-building mr-1"></i><%= profile.company %><% } %>
            </p>
            <% } %>

            <!-- Social Links -->
            <% if (profile.socialLinks && Object.keys(profile.socialLinks).length > 0) { %>
            <div class="flex justify-center space-x-4 mt-4">
                <% const socialIcons = { twitter: 'fab fa-twitter', instagram: 'fab fa-instagram', facebook: 'fab fa-facebook', linkedin: 'fab fa-linkedin', github: 'fab fa-github', youtube: 'fab fa-youtube', tiktok: 'fab fa-tiktok' }; %>
                <% Object.entries(profile.socialLinks).forEach(([platform, url]) => { %>
                <a href="<%= url %>" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/30 transition text-white">
                    <i class="<%= socialIcons[platform] || 'fas fa-link' %>"></i>
                </a>
                <% }) %>
            </div>
            <% } %>

            <!-- Spotlight CTA -->
            <% if (profile.spotlightLabel && profile.spotlightUrl) { %>
            <div class="mt-6">
                <a href="<%= profile.spotlightUrl %>" target="_blank" rel="noopener" class="inline-flex items-center px-8 py-3 bg-yellow-400 text-gray-900 font-bold rounded-full hover:bg-yellow-300 transition shadow-lg text-lg">
                    <% if (profile.spotlightIcon) { %><i class="fas fa-<%= profile.spotlightIcon %> mr-2"></i><% } %>
                    <%= profile.spotlightLabel %>
                </a>
            </div>
            <% } %>

            <!-- Links -->
            <% if (links.length > 0) { %>
            <div class="mt-8 space-y-3">
                <% links.forEach(link => { %>
                <a href="/click/<%= link.id %>" class="block w-full py-3 px-6 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl hover:bg-white/20 transition text-center <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900 border-gray-300' %>">
                    <% if (link.icon) { %>
                    <i class="<%= ['github','linkedin','twitter','instagram','youtube','facebook','tiktok'].includes(link.icon) ? 'fab' : 'fas' %> fa-<%= link.icon %> mr-2"></i>
                    <% } %>
                    <%= link.title %>
                </a>
                <% }) %>
            </div>
            <% } %>

            <!-- Testimonials -->
            <% if (user.isPremiumUser && profile.testimonials && profile.testimonials.length > 0) { %>
            <div class="mt-10">
                <h3 class="text-lg font-semibold mb-4 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                    <i class="fas fa-quote-left mr-2"></i>Testimonials
                </h3>
                <div class="space-y-3">
                    <% profile.testimonials.forEach(t => { %>
                    <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-4 text-left">
                        <p class="italic <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/90' : 'text-gray-700' %>">"<%= t.text %>"</p>
                        <p class="mt-2 text-sm font-semibold <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                            &mdash; <%= t.name %><% if (t.role) { %>, <span class="font-normal opacity-70"><%= t.role %></span><% } %>
                        </p>
                    </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Resume -->
            <% if (user.isPremiumUser && profile.resume) { %>
            <% const resume = profile.resume; %>
            <% if ((resume.experience && resume.experience.length > 0) || (resume.education && resume.education.length > 0) || (resume.skills && resume.skills.length > 0)) { %>
            <div class="mt-10 text-left">
                <h3 class="text-lg font-semibold mb-4 text-center <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                    <i class="fas fa-file-alt mr-2"></i>Resume
                </h3>
                <% ['experience', 'education'].forEach(section => { %>
                <% if (resume[section] && resume[section].length > 0) { %>
                <h4 class="font-medium capitalize mt-4 mb-2 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/80' : 'text-gray-600' %>"><%= section %></h4>
                <% resume[section].forEach(item => { %>
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg p-3 mb-2">
                    <p class="font-semibold <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>"><%= item.title %></p>
                    <% if (item.subtitle) { %><p class="text-sm <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/70' : 'text-gray-600' %>"><%= item.subtitle %></p><% } %>
                    <% if (item.period) { %><p class="text-xs <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/50' : 'text-gray-400' %>"><%= item.period %></p><% } %>
                    <% if (item.description) { %><p class="text-sm mt-1 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/80' : 'text-gray-700' %>"><%= item.description %></p><% } %>
                </div>
                <% }) %>
                <% } %>
                <% }) %>
                <% if (resume.skills && resume.skills.length > 0) { %>
                <h4 class="font-medium mt-4 mb-2 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/80' : 'text-gray-600' %>">Skills</h4>
                <div class="flex flex-wrap gap-2">
                    <% resume.skills.forEach(skill => { %>
                    <span class="px-3 py-1 bg-white/20 rounded-full text-sm <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>"><%= skill.title %></span>
                    <% }) %>
                </div>
                <% } %>
            </div>
            <% } %>
            <% } %>

            <!-- Gallery -->
            <% if (user.isPremiumUser && profile.gallery && profile.gallery.length > 0) { %>
            <div class="mt-10">
                <h3 class="text-lg font-semibold mb-4 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                    <i class="fas fa-images mr-2"></i>Gallery
                </h3>
                <div class="grid grid-cols-2 gap-3">
                    <% profile.gallery.forEach(img => { %>
                    <img src="/uploads/<%= img %>" class="w-full h-32 object-cover rounded-lg" alt="Gallery">
                    <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Videos -->
            <% if (user.isPremiumUser && profile.videos && profile.videos.length > 0) { %>
            <div class="mt-10">
                <h3 class="text-lg font-semibold mb-4 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                    <i class="fas fa-video mr-2"></i>Videos
                </h3>
                <div class="space-y-3">
                    <% profile.videos.forEach(v => { %>
                    <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-4">
                        <% if (v.title) { %><p class="font-medium mb-2 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>"><%= v.title %></p><% } %>
                        <a href="<%= v.url %>" target="_blank" rel="noopener" class="text-sm text-indigo-300 hover:text-indigo-200"><i class="fas fa-play mr-1"></i>Watch Video</a>
                    </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Contact Form -->
            <% if (user.isPremiumUser && profile.contactFormEnabled) { %>
            <div class="mt-10" x-data="{ showForm: false }">
                <button @click="showForm = !showForm" class="w-full py-3 px-6 bg-white/20 backdrop-blur-sm border border-white/20 rounded-xl hover:bg-white/30 transition <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                    <i class="fas fa-envelope mr-2"></i>Contact Me
                </button>
                <div x-show="showForm" x-transition class="mt-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6">
                    <form method="POST" action="/<%= profile.username %>/contact" class="space-y-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="text" name="sender_name" placeholder="Your Name" required class="w-full px-4 py-2 bg-white/20 border border-white/20 rounded-lg placeholder-white/50 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                        <input type="email" name="sender_email" placeholder="Your Email" required class="w-full px-4 py-2 bg-white/20 border border-white/20 rounded-lg placeholder-white/50 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>">
                        <textarea name="message" placeholder="Your Message" required rows="4" class="w-full px-4 py-2 bg-white/20 border border-white/20 rounded-lg placeholder-white/50 <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white' : 'text-gray-900' %>"></textarea>
                        <button type="submit" class="w-full py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition"><i class="fas fa-paper-plane mr-2"></i>Send Message</button>
                    </form>
                </div>
            </div>
            <% } %>

            <!-- QR Code -->
            <div class="mt-10" x-data="{ showQR: false }">
                <button @click="showQR = !showQR" class="text-sm <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/60 hover:text-white/80' : 'text-gray-500 hover:text-gray-700' %> transition">
                    <i class="fas fa-qrcode mr-1"></i>Share via QR Code
                </button>
                <div x-show="showQR" x-transition class="mt-3">
                    <div class="inline-block bg-white p-4 rounded-xl">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(appUrl + '/' + profile.username) %>" alt="QR Code" class="w-36 h-36">
                    </div>
                </div>
            </div>

            <!-- Branding -->
            <% if (profile.showBranding) { %>
            <div class="mt-8">
                <a href="/" class="text-sm <%= ['dark', 'default', 'gradient', 'bold', 'ocean', 'sunset', 'forest'].includes(profile.theme) || profile.backgroundImage ? 'text-white/40 hover:text-white/60' : 'text-gray-400 hover:text-gray-600' %> transition">
                    Made with <i class="fas fa-rocket mx-1"></i> DropLaunch
                </a>
            </div>
            <% } %>
        </div>
    </div>
</body>
</html>
