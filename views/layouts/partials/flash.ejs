<% if (typeof success !== 'undefined' && success.length > 0) { %>
<div class="mb-4 bg-green-100 dark:bg-green-900/50 border border-green-400 text-green-700 dark:text-green-300 px-4 py-3 rounded"><%= success[0] %></div>
<% } %>
<% if (typeof error !== 'undefined' && error.length > 0) { %>
<div class="mb-4 bg-red-100 dark:bg-red-900/50 border border-red-400 text-red-700 dark:text-red-300 px-4 py-3 rounded"><%= error[0] %></div>
<% } %>
