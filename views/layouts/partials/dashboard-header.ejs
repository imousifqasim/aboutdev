<header class="flex items-center justify-between h-14 px-4 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 shadow-sm">
    <button @click="sidebarOpen = true" class="md:hidden text-gray-500 hover:text-gray-700"><i class="fas fa-bars text-lg"></i></button>
    <h1 class="text-base font-semibold"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1>
    <div class="flex items-center space-x-2">
        <button @click="darkMode = !darkMode; localStorage.setItem('darkMode', darkMode)" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
            <i x-show="!darkMode" class="fas fa-moon text-gray-600"></i>
            <i x-show="darkMode" class="fas fa-sun text-yellow-400"></i>
        </button>
        <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="text-gray-500 hover:text-red-600"><i class="fas fa-sign-out-alt"></i></button></form>
    </div>
</header>
