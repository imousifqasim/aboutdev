<aside x-data="{ currentPath: window.location.pathname }" class="hidden md:flex md:flex-shrink-0">
    <div class="flex flex-col w-64 bg-white dark:bg-slate-950 border-r border-slate-200 dark:border-slate-800">
        <div class="flex items-center h-16 px-5 border-b border-slate-200 dark:border-slate-800">
            <a href="/" class="text-xl font-bold tracking-tight text-slate-900 dark:text-white"><i class="fas fa-rocket mr-2 text-indigo-600"></i><%= appName %></a>
        </div>
        <nav class="flex-1 px-3 py-5 space-y-2 overflow-y-auto">
            <a href="/dashboard" :class="currentPath === '/dashboard' ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition">
                <i class="fas fa-tachometer-alt w-5"></i>Dashboard
            </a>
            <a href="/dashboard/profile" :class="currentPath.startsWith('/dashboard/profile') ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition">
                <i class="fas fa-user w-5"></i>Profile
            </a>
            <a href="/dashboard/links" :class="currentPath.startsWith('/dashboard/links') ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition">
                <i class="fas fa-link w-5"></i>Links
            </a>
            <a href="/dashboard/email-signature" :class="currentPath === '/dashboard/email-signature' ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition">
                <i class="fas fa-envelope w-5"></i>Email Signature
            </a>
            <a href="/dashboard/messages" :class="currentPath.startsWith('/dashboard/messages') ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition">
                <i class="fas fa-inbox w-5"></i>Messages
            </a>
            <a href="/dashboard/payments" :class="currentPath.startsWith('/dashboard/payments') ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition">
                <i class="fas fa-credit-card w-5"></i>Subscription
            </a>
            <% if (user && user.profile) { %>
            <a href="/<%= user.profile.username %>" target="_blank" class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl text-indigo-600 dark:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                <i class="fas fa-external-link-alt w-5"></i>View Profile
            </a>
            <% } %>
        </nav>
        <div class="p-4 border-t border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white"><%= user.name.charAt(0).toUpperCase() %></div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white"><%= user.name %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= user.email %></p>
                </div>
            </div>
        </div>
    </div>
</aside>
