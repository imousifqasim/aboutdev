<aside class="hidden md:flex md:flex-shrink-0">
    <div class="flex flex-col w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700">
        <div class="flex items-center h-16 px-4 border-b border-gray-200 dark:border-gray-700">
            <a href="/" class="text-xl font-bold text-indigo-600 dark:text-indigo-400"><i class="fas fa-rocket mr-2"></i><%= appName %></a>
        </div>
        <nav class="flex-1 px-2 py-4 space-y-1 overflow-y-auto">
            <a href="/dashboard" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300"><i class="fas fa-tachometer-alt w-5 mr-3"></i>Dashboard</a>
            <a href="/dashboard/profile" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300"><i class="fas fa-user w-5 mr-3"></i>Profile</a>
            <a href="/dashboard/links" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300"><i class="fas fa-link w-5 mr-3"></i>Links</a>
            <a href="/dashboard/email-signature" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300"><i class="fas fa-envelope w-5 mr-3"></i>Email Signature</a>
            <a href="/dashboard/messages" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300"><i class="fas fa-inbox w-5 mr-3"></i>Messages</a>
            <a href="/dashboard/payments" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300"><i class="fas fa-credit-card w-5 mr-3"></i>Subscription</a>
            <% if (user && user.profile) { %>
            <a href="/<%= user.profile.username %>" target="_blank" class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-indigo-600 dark:text-indigo-400"><i class="fas fa-external-link-alt w-5 mr-3"></i>View Profile</a>
            <% } %>
        </nav>
        <div class="p-4 border-t border-gray-200 dark:border-gray-700">
            <div class="flex items-center">
                <div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white text-sm font-bold"><%= user.name.charAt(0).toUpperCase() %></div>
                <div class="ml-3"><p class="text-sm font-medium"><%= user.name %></p><p class="text-xs text-gray-500 dark:text-gray-400"><%= user.email %></p></div>
            </div>
        </div>
    </div>
</aside>
