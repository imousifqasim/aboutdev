<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'DropLaunch' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <%- include('../layouts/navigation') %>

    <% if (typeof success !== 'undefined' && success.length > 0) { %>
    <div class="max-w-7xl mx-auto px-4 pt-4">
        <div class="bg-green-100 dark:bg-green-900/50 border border-green-400 text-green-700 dark:text-green-300 px-4 py-3 rounded relative">
            <%= success[0] %>
        </div>
    </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="max-w-7xl mx-auto px-4 pt-4">
        <div class="bg-red-100 dark:bg-red-900/50 border border-red-400 text-red-700 dark:text-red-300 px-4 py-3 rounded relative">
            <%= error[0] %>
        </div>
    </div>
    <% } %>

    <%- body %>

    <%- include('../layouts/footer') %>
</body>
</html>
