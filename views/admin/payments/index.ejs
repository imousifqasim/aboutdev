<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head><%- include('../../layouts/partials/head') %><title>Payments - <%= appName %></title></head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
<div class="flex h-screen overflow-hidden">
    <%- include('../../layouts/partials/admin-sidebar') %>
    <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../../layouts/partials/dashboard-header', { title: 'Payments' }) %>
        <main class="flex-1 overflow-y-auto p-5">
            <%- include('../../layouts/partials/flash') %>
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md border border-gray-200 dark:border-gray-700">
                <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-700"><th class="text-left py-3 px-4">User</th><th class="text-left py-3 px-4">Method</th><th class="text-left py-3 px-4">Amount</th><th class="text-left py-3 px-4">Transaction ID</th><th class="text-left py-3 px-4">Status</th><th class="text-left py-3 px-4">Date</th><th class="text-left py-3 px-4">Actions</th></tr></thead><tbody>
                <% payments.forEach(function(p) { %>
                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td class="py-3 px-4"><%= p.user.name %></td>
                    <td class="py-3 px-4"><%= p.method %></td>
                    <td class="py-3 px-4">$<%= parseFloat(p.amount).toFixed(2) %></td>
                    <td class="py-3 px-4 font-mono text-xs"><%= p.transactionId %></td>
                    <td class="py-3 px-4"><span class="px-2 py-1 text-xs rounded-full font-medium <%= p.status === 'approved' ? 'bg-green-100 text-green-800' : p.status === 'rejected' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>"><%= p.status %></span></td>
                    <td class="py-3 px-4"><%= new Date(p.createdAt).toLocaleDateString() %></td>
                    <td class="py-3 px-4"><a href="/admin/payments/<%= p.id %>" class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded text-sm"><i class="fas fa-eye mr-1"></i>View</a></td>
                </tr>
                <% }) %>
                </tbody></table></div>
                <% if (payments.length === 0) { %><div class="p-8 text-center text-gray-500">No payments yet.</div><% } %>
            </div>
        </main>
    </div>
</div>
</body>
</html>
