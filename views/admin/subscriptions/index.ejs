<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head><%- include('../../layouts/partials/head') %><title>Subscriptions - <%= appName %></title></head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
<div class="flex h-screen overflow-hidden">
    <%- include('../../layouts/partials/admin-sidebar') %>
    <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../../layouts/partials/dashboard-header', { title: 'Subscriptions' }) %>
        <main class="flex-1 overflow-y-auto p-6">
            <%- include('../../layouts/partials/flash') %>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-700"><th class="text-left py-3 px-4">User</th><th class="text-left py-3 px-4">Plan</th><th class="text-left py-3 px-4">Status</th><th class="text-left py-3 px-4">Started</th><th class="text-left py-3 px-4">Ends</th><th class="text-left py-3 px-4">Actions</th></tr></thead><tbody>
                <% users.forEach(function(u) { %>
                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td class="py-3 px-4"><div class="flex items-center"><div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white text-sm font-bold mr-3"><%= u.name.charAt(0) %></div><div><p class="font-medium"><%= u.name %></p><p class="text-xs text-gray-500"><%= u.email %></p></div></div></td>
                    <td class="py-3 px-4"><span class="px-2 py-1 text-xs rounded-full font-medium <%= u.profile && u.profile.isPremium ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>"><% if (u.profile && u.profile.isPremium) { %><i class="fas fa-crown mr-1"></i>Premium<% } else { %>Free<% } %></span></td>
                    <td class="py-3 px-4"><% if (u.subscriptions && u.subscriptions.length > 0 && u.subscriptions[0].isActive) { %><span class="px-2 py-1 text-xs rounded-full font-medium bg-green-100 text-green-800">Active</span><% } else { %><span class="px-2 py-1 text-xs rounded-full font-medium bg-gray-100 text-gray-800">-</span><% } %></td>
                    <td class="py-3 px-4"><% if (u.subscriptions && u.subscriptions.length > 0) { %><%= new Date(u.subscriptions[0].startDate).toLocaleDateString() %><% } else { %>-<% } %></td>
                    <td class="py-3 px-4"><% if (u.subscriptions && u.subscriptions.length > 0 && u.subscriptions[0].endDate) { %><%= new Date(u.subscriptions[0].endDate).toLocaleDateString() %><% } else { %>-<% } %></td>
                    <td class="py-3 px-4"><% if (u.role !== 'admin') { %><form method="POST" action="/admin/users/<%= u.id %>/premium"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="px-3 py-1 rounded text-sm font-medium <%= u.profile && u.profile.isPremium ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>"><% if (u.profile && u.profile.isPremium) { %>Deactivate<% } else { %>Activate<% } %></button></form><% } %></td>
                </tr>
                <% }) %>
                </tbody></table></div>
            </div>
        </main>
    </div>
</div>
</body>
</html>
