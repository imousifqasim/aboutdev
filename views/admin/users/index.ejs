<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head><%- include('../../layouts/partials/head') %><title>Users - <%= appName %></title></head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
<div class="flex h-screen overflow-hidden">
    <%- include('../../layouts/partials/admin-sidebar') %>
    <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../../layouts/partials/dashboard-header', { title: 'Users' }) %>
        <main class="flex-1 overflow-y-auto p-6">
            <%- include('../../layouts/partials/flash') %>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                    <form method="GET" action="/admin/users" class="flex items-center space-x-3">
                        <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search users..." class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700">
                        <select name="status" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700">
                            <option value="">All</option><option value="premium" <%= typeof status !== 'undefined' && status === 'premium' ? 'selected' : '' %>>Premium</option><option value="free" <%= typeof status !== 'undefined' && status === 'free' ? 'selected' : '' %>>Free</option><option value="banned" <%= typeof status !== 'undefined' && status === 'banned' ? 'selected' : '' %>>Banned</option>
                        </select>
                        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition"><i class="fas fa-search mr-1"></i>Search</button>
                    </form>
                </div>
                <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-700"><th class="text-left py-3 px-4">User</th><th class="text-left py-3 px-4">Email</th><th class="text-left py-3 px-4">Plan</th><th class="text-left py-3 px-4">Status</th><th class="text-left py-3 px-4">Joined</th><th class="text-left py-3 px-4">Actions</th></tr></thead><tbody>
                <% users.forEach(function(u) { %>
                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td class="py-3 px-4"><div class="flex items-center"><div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white text-sm font-bold mr-3"><%= u.name.charAt(0) %></div><div><p class="font-medium"><%= u.name %></p><% if (u.profile) { %><p class="text-xs text-gray-500">@<%= u.profile.username %></p><% } %></div></div></td>
                    <td class="py-3 px-4"><%= u.email %></td>
                    <td class="py-3 px-4"><span class="px-2 py-1 text-xs rounded-full font-medium <%= u.profile && u.profile.isPremium ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>"><% if (u.profile && u.profile.isPremium) { %><i class="fas fa-crown mr-1"></i>Premium<% } else { %>Free<% } %></span></td>
                    <td class="py-3 px-4"><% if (u.isBanned) { %><span class="px-2 py-1 text-xs rounded-full font-medium bg-red-100 text-red-800">Banned</span><% } else { %><span class="px-2 py-1 text-xs rounded-full font-medium bg-green-100 text-green-800">Active</span><% } %></td>
                    <td class="py-3 px-4"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                    <td class="py-3 px-4"><div class="flex space-x-2"><a href="/admin/users/<%= u.id %>" class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded text-sm"><i class="fas fa-eye"></i></a><% if (u.role !== 'admin') { %><form method="POST" action="/admin/users/<%= u.id %>/ban"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="px-3 py-1 rounded text-sm <%= u.isBanned ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><i class="fas fa-<%= u.isBanned ? 'unlock' : 'ban' %>"></i></button></form><form method="POST" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Delete this user?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="px-3 py-1 bg-red-100 text-red-700 rounded text-sm"><i class="fas fa-trash"></i></button></form><% } %></div></td>
                </tr>
                <% }) %>
                </tbody></table></div>
            </div>
        </main>
    </div>
</div>
</body>
</html>
