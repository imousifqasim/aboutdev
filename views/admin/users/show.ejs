<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head><%- include('../../layouts/partials/head') %><title><%= targetUser.name %> - Admin - <%= appName %></title></head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
<div class="flex h-screen overflow-hidden">
    <%- include('../../layouts/partials/admin-sidebar') %>
    <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../../layouts/partials/dashboard-header', { title: 'User Details' }) %>
        <main class="flex-1 overflow-y-auto p-6">
            <%- include('../../layouts/partials/flash') %>
            <div class="max-w-4xl space-y-6">
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="w-16 h-16 rounded-full bg-indigo-500 flex items-center justify-center text-white text-2xl font-bold"><%= targetUser.name.charAt(0) %></div>
                            <div>
                                <h2 class="text-xl font-bold"><%= targetUser.name %></h2>
                                <p class="text-gray-500"><%= targetUser.email %></p>
                                <% if (targetUser.profile) { %><p class="text-sm text-indigo-600">@<%= targetUser.profile.username %></p><% } %>
                            </div>
                        </div>
                        <div class="flex space-x-2">
                            <% if (targetUser.role !== 'admin') { %>
                            <form method="POST" action="/admin/users/<%= targetUser.id %>/ban"><button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium <%= targetUser.isBanned ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><i class="fas fa-<%= targetUser.isBanned ? 'unlock' : 'ban' %> mr-1"></i><%= targetUser.isBanned ? 'Unban' : 'Ban' %></button></form>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="grid md:grid-cols-3 gap-6">
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 text-center">
                        <p class="text-sm text-gray-500">Plan</p><p class="text-lg font-bold mt-1"><% if (targetUser.profile && targetUser.profile.isPremium) { %><i class="fas fa-crown text-yellow-500 mr-1"></i>Premium<% } else { %>Free<% } %></p>
                    </div>
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 text-center">
                        <p class="text-sm text-gray-500">Links</p><p class="text-lg font-bold mt-1"><%= targetUser.links ? targetUser.links.length : 0 %></p>
                    </div>
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 text-center">
                        <p class="text-sm text-gray-500">Joined</p><p class="text-lg font-bold mt-1"><%= new Date(targetUser.createdAt).toLocaleDateString() %></p>
                    </div>
                </div>
                <% if (targetUser.payments && targetUser.payments.length > 0) { %>
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                    <h3 class="font-semibold text-lg mb-4">Payment History</h3>
                    <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b dark:border-gray-700"><th class="text-left py-2 px-3">Method</th><th class="text-left py-2 px-3">Amount</th><th class="text-left py-2 px-3">Status</th><th class="text-left py-2 px-3">Date</th></tr></thead><tbody>
                    <% targetUser.payments.forEach(function(p) { %>
                    <tr class="border-b dark:border-gray-700"><td class="py-2 px-3"><%= p.method %></td><td class="py-2 px-3">$<%= parseFloat(p.amount).toFixed(2) %></td><td class="py-2 px-3"><span class="px-2 py-0.5 text-xs rounded-full font-medium <%= p.status === 'approved' ? 'bg-green-100 text-green-800' : p.status === 'rejected' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>"><%= p.status %></span></td><td class="py-2 px-3"><%= new Date(p.createdAt).toLocaleDateString() %></td></tr>
                    <% }) %>
                    </tbody></table></div>
                </div>
                <% } %>
                <a href="/admin/users" class="inline-flex items-center text-indigo-600 hover:text-indigo-800"><i class="fas fa-arrow-left mr-2"></i>Back to Users</a>
            </div>
        </main>
    </div>
</div>
</body>
</html>
