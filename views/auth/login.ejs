<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - <%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwindcss.config = { darkMode: 'class' }</script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center transition-colors">
    <div class="max-w-md w-full mx-4">
        <div class="text-center mb-8">
            <a href="/" class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"><i class="fas fa-rocket mr-2"></i><%= appName %></a>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Welcome back! Log in to your account.</p>
        </div>

        <% if (typeof error !== 'undefined' && error.length > 0) { %>
        <div class="mb-4 bg-red-100 dark:bg-red-900/50 border border-red-400 text-red-700 dark:text-red-300 px-4 py-3 rounded"><%= error[0] %></div>
        <% } %>

        <div class="bg-white dark:bg-gray-800 shadow-xl rounded-2xl p-8">
            <form method="POST" action="/login">
                <div class="mb-4">
                    <label class="block text-sm font-medium mb-1">Email</label>
                    <input type="email" name="email" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-medium mb-1">Password</label>
                    <input type="password" name="password" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                </div>
                <button type="submit" class="w-full py-3 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition">
                    <i class="fas fa-sign-in-alt mr-2"></i>Login
                </button>
            </form>
        </div>
        <p class="text-center mt-6 text-sm text-gray-600 dark:text-gray-400">
            Don't have an account? <a href="/register" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">Sign Up</a>
        </p>
    </div>
</body>
</html>
