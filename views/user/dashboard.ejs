<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - <%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors">
    <div class="flex min-h-screen overflow-hidden">
        <%- include('../layouts/partials/user-sidebar') %>
        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="flex items-center justify-between gap-4 px-6 py-5 bg-white/80 dark:bg-slate-950/90 border-b border-slate-200 dark:border-slate-800 backdrop-blur">
                <div>
                    <p class="text-xs uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Dashboard</p>
                    <h1 class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100">Welcome back, <span class="text-indigo-600 dark:text-indigo-400"><%= user.name %></span></h1>
                    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Your profile is live and ready to attract visitors. Manage your links, settings, and premium features from here.</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="rounded-3xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-3 text-slate-700 dark:text-slate-100 shadow-sm">
                        <p class="text-xs uppercase tracking-[0.24em] text-slate-400">Plan</p>
                        <p class="mt-1 font-semibold"><%= user.isPremiumUser ? 'Premium' : 'Free' %></p>
                    </div>
                    <a href="/dashboard/profile" class="inline-flex items-center gap-2 rounded-full bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/20 hover:bg-indigo-500 transition"><i class="fas fa-user-edit"></i> Edit Profile</a>
                </div>
            </header>
            <main class="flex-1 overflow-y-auto p-6 lg:p-8">
                <div class="grid gap-6 xl:grid-cols-[1.8fr_1fr] mb-6">
                    <section class="rounded-[2rem] bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-700 text-white p-8 shadow-2xl shadow-indigo-500/10 overflow-hidden relative">
                        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.15),_transparent_40%)]"></div>
                        <div class="relative z-10 grid gap-6 lg:grid-cols-[1.5fr_1fr] items-center">
                            <div>
                                <p class="text-sm uppercase tracking-[0.3em] text-slate-300">Premium Dashboard</p>
                                <h2 class="mt-4 text-3xl font-semibold">Grow your audience with your page</h2>
                                <p class="mt-4 max-w-xl text-slate-200/90">Track profile views, manage links, and see what's working at a glance. Your premium tools are one click away.</p>
                                <div class="mt-6 flex flex-wrap gap-3">
                                    <a href="/dashboard/links" class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white border border-white/10 hover:bg-white/15 transition"><i class="fas fa-link"></i> Manage Links</a>
                                    <a href="/dashboard/payments" class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white border border-white/10 hover:bg-white/15 transition"><i class="fas fa-credit-card"></i> Subscription</a>
                                </div>
                            </div>
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div class="rounded-3xl border border-white/10 bg-white/10 p-5 shadow-lg shadow-black/10 backdrop-blur">
                                    <p class="text-xs uppercase tracking-[0.28em] text-slate-200">Plan Status</p>
                                    <p class="mt-3 text-xl font-semibold"><%= user.isPremiumUser ? 'Active Premium' : 'Free User' %></p>
                                </div>
                                <div class="rounded-3xl border border-white/10 bg-white/10 p-5 shadow-lg shadow-black/10 backdrop-blur">
                                    <p class="text-xs uppercase tracking-[0.28em] text-slate-200">Profile Link</p>
                                    <a href="/<%= user.profile ? user.profile.username : '' %>" target="_blank" class="mt-3 block text-sm font-semibold text-white underline"><%= user.profile ? '/' + user.profile.username : 'Set username' %></a>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="grid gap-6">
                        <div class="rounded-[2rem] bg-white dark:bg-slate-900 p-6 shadow-lg shadow-slate-900/5 border border-slate-200 dark:border-slate-800">
                            <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Quick Metrics</p>
                            <div class="mt-6 grid gap-4 sm:grid-cols-2">
                                <div class="rounded-3xl bg-slate-50 dark:bg-slate-950 p-5 border border-slate-200 dark:border-slate-800">
                                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Profile Views</p>
                                    <p class="mt-3 text-3xl font-semibold text-slate-900 dark:text-white"><%= totalViews %></p>
                                </div>
                                <div class="rounded-3xl bg-slate-50 dark:bg-slate-950 p-5 border border-slate-200 dark:border-slate-800">
                                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Link Clicks</p>
                                    <p class="mt-3 text-3xl font-semibold text-slate-900 dark:text-white"><%= totalClicks %></p>
                                </div>
                                <div class="rounded-3xl bg-slate-50 dark:bg-slate-950 p-5 border border-slate-200 dark:border-slate-800">
                                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Total Links</p>
                                    <p class="mt-3 text-3xl font-semibold text-slate-900 dark:text-white"><%= totalLinks %></p>
                                </div>
                                <div class="rounded-3xl bg-slate-50 dark:bg-slate-950 p-5 border border-slate-200 dark:border-slate-800">
                                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Premium</p>
                                    <p class="mt-3 text-3xl font-semibold text-slate-900 dark:text-white"><%= user.isPremiumUser ? 'Enabled' : 'Upgrade' %></p>
                                </div>
                            </div>
                        </div>
                        <div class="rounded-[2rem] bg-white dark:bg-slate-900 p-6 shadow-lg shadow-slate-900/5 border border-slate-200 dark:border-slate-800">
                            <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Actions</p>
                            <div class="mt-6 space-y-3">
                                <a href="/dashboard/profile" class="flex items-center justify-between rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 px-4 py-4 text-slate-700 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                                    <span>Edit your profile</span><i class="fas fa-chevron-right"></i>
                                </a>
                                <a href="/dashboard/links" class="flex items-center justify-between rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 px-4 py-4 text-slate-700 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                                    <span>Manage links</span><i class="fas fa-chevron-right"></i>
                                </a>
                                <a href="/dashboard/payments" class="flex items-center justify-between rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 px-4 py-4 text-slate-700 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                                    <span>Subscription settings</span><i class="fas fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="grid gap-6 lg:grid-cols-[1.4fr_0.8fr]">
                    <div class="rounded-[2rem] bg-white dark:bg-slate-900 p-6 shadow-lg shadow-slate-900/5 border border-slate-200 dark:border-slate-800">
                        <div class="flex items-center justify-between gap-4">
                            <div>
                                <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Traffic Overview</h2>
                                <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Last 30 days of profile activity.</p>
                            </div>
                            <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Updated now</span>
                        </div>
                        <div class="mt-6">
                            <canvas id="analyticsChart" height="220"></canvas>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <div class="rounded-[2rem] bg-white dark:bg-slate-900 p-6 shadow-lg shadow-slate-900/5 border border-slate-200 dark:border-slate-800">
                            <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Profile Summary</h2>
                            <div class="mt-4 space-y-4 text-sm text-slate-600 dark:text-slate-300">
                                <p><span class="font-semibold text-slate-900 dark:text-white">Username:</span> @<%= user.profile ? user.profile.username : 'not set' %></p>
                                <p><span class="font-semibold text-slate-900 dark:text-white">Custom Domain:</span> <%= user.profile && user.profile.customDomain ? user.profile.customDomain : 'None' %></p>
                                <p><span class="font-semibold text-slate-900 dark:text-white">Theme:</span> <%= user.profile ? user.profile.theme : 'default' %></p>
                            </div>
                        </div>
                        <div class="rounded-[2rem] bg-indigo-600 p-6 text-white shadow-2xl shadow-indigo-500/20">
                            <h2 class="text-xl font-semibold">Need help?</h2>
                            <p class="mt-3 text-sm text-indigo-100/90">Visit the support page, change your profile theme, or contact us directly if you need assistance with your page setup.</p>
                            <a href="/dashboard/profile" class="mt-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20 transition"><i class="fas fa-life-ring"></i>Customize profile</a>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script>
    const chartData = <%- JSON.stringify(chartData) %>;
    const ctx = document.getElementById('analyticsChart');
    if (ctx) {
        new Chart(ctx.getContext('2d'), {
            type: 'line',
            data: {
                labels: chartData.map(d => d.date),
                datasets: [
                    { label: 'Views', data: chartData.map(d => d.views), borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,0.16)', fill: true, tension: 0.4 },
                    { label: 'Clicks', data: chartData.map(d => d.clicks), borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.16)', fill: true, tension: 0.4 },
                ],
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } }, scales: { x: { display: false }, y: { beginAtZero: true } } },
        });
    }
    </script>
</body>
</html>
