<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - <%= appName %></title>
    <%- include('../../layouts/partials/head') %>
</head>
<body class="bg-gray-50 dark:bg-gray-900">
    <%- include('../../layouts/partials/dashboard-header') %>

    <div class="flex">
        <%- include('../../layouts/partials/user-sidebar') %>

        <main class="flex-1 p-8">
            <div class="max-w-4xl mx-auto">
                <!-- Header -->
                <div class="mb-8">
                    <div class="flex items-center space-x-4 mb-4">
                        <a href="/dashboard/settings" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300">
                            <i class="fas fa-arrow-left"></i>
                        </a>
                        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">API & Integrations</h1>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400">Manage API keys and third-party integrations</p>
                </div>

                <%- include('../../layouts/partials/flash') %>

                <!-- API Keys -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">API Keys</h3>
                        <button class="px-4 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition">
                            <i class="fas fa-plus mr-2"></i>Generate New Key
                        </button>
                    </div>
                    
                    <p class="text-gray-600 dark:text-gray-400 text-center py-8">
                        <i class="fas fa-key text-3xl text-gray-300 dark:text-gray-600 mb-2 block"></i>
                        No API keys created yet
                    </p>
                </div>

                <!-- Webhook Integrations -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Webhooks</h3>
                        <button class="px-4 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition">
                            <i class="fas fa-plus mr-2"></i>Add Webhook
                        </button>
                    </div>
                    
                    <p class="text-gray-600 dark:text-gray-400 text-center py-8">
                        <i class="fas fa-link text-3xl text-gray-300 dark:text-gray-600 mb-2 block"></i>
                        No webhooks configured yet
                    </p>
                </div>

                <!-- Third-Party Integrations -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Available Integrations</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Mailchimp Integration -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white">Mailchimp</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Email marketing automation</p>
                                </div>
                                <button class="px-3 py-1 border border-indigo-600 text-indigo-600 text-sm font-medium rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition">
                                    Connect
                                </button>
                            </div>
                        </div>

                        <!-- Zapier Integration -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white">Zapier</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Connect with 1000+ apps</p>
                                </div>
                                <button class="px-3 py-1 border border-indigo-600 text-indigo-600 text-sm font-medium rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition">
                                    Connect
                                </button>
                            </div>
                        </div>

                        <!-- Google Analytics Integration -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white">Google Analytics</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Advanced website analytics</p>
                                </div>
                                <button class="px-3 py-1 border border-indigo-600 text-indigo-600 text-sm font-medium rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition">
                                    Connect
                                </button>
                            </div>
                        </div>

                        <!-- Stripe Integration -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white">Stripe</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Payment processing</p>
                                </div>
                                <button class="px-3 py-1 border border-indigo-600 text-indigo-600 text-sm font-medium rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition">
                                    Connect
                                </button>
                            </div>
                        </div>

                        <!-- Slack Integration -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white">Slack</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Team notifications</p>
                                </div>
                                <button class="px-3 py-1 border border-indigo-600 text-indigo-600 text-sm font-medium rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition">
                                    Connect
                                </button>
                            </div>
                        </div>

                        <!-- SendGrid Integration -->
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white">SendGrid</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Transactional emails</p>
                                </div>
                                <button class="px-3 py-1 border border-indigo-600 text-indigo-600 text-sm font-medium rounded hover:bg-indigo-50 dark:hover:bg-indigo-900 transition">
                                    Connect
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- API Documentation -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Documentation</h3>
                    
                    <div class="space-y-3">
                        <a href="#" class="flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300">
                            <i class="fas fa-file-alt mr-2"></i>
                            API Documentation
                        </a>
                        <a href="#" class="flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300">
                            <i class="fas fa-book mr-2"></i>
                            Integration Guide
                        </a>
                        <a href="#" class="flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300">
                            <i class="fas fa-code mr-2"></i>
                            Code Examples
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
