<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', currentPath: window.location.pathname }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - <%= appName %></title>
    <%- include('../../layouts/partials/head') %>
</head>
<body class="bg-gray-50 dark:bg-gray-900">
    <%- include('../../layouts/partials/dashboard-header') %>

    <div class="flex">
        <%- include('../../layouts/partials/user-sidebar') %>

        <main class="flex-1 flex">
            <!-- Settings Submenu -->
            <%- include('./partials/submenu') %>

            <!-- Settings Content -->
            <div class="flex-1 p-8">
                <!-- Header -->
                <div class="mb-8">
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Billing & Subscription</h1>
                    <p class="text-gray-600 dark:text-gray-400 mt-2">Manage your subscription plan and payment methods</p>
                </div>

                <%- include('../../layouts/partials/flash') %>

                <!-- Current Plan -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Current Plan</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Free Plan Card -->
                        <div class="border-2 border-indigo-500 rounded-lg p-6">
                            <div class="flex items-center justify-between mb-4">
                                <h4 class="text-lg font-semibold text-gray-900 dark:text-white">Free</h4>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
                                    Current
                                </span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white mb-4">$0<span class="text-lg font-normal text-gray-600 dark:text-gray-400">/month</span></p>
                            <ul class="space-y-3 mb-6">
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    1 Portfolio
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Basic Templates
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Analytics
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-times-circle text-red-500 mr-3"></i>
                                    Custom Domain
                                </li>
                            </ul>
                        </div>

                        <!-- Pro Plan Card -->
                        <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6">
                            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Pro</h4>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white mb-4">$9.99<span class="text-lg font-normal text-gray-600 dark:text-gray-400">/month</span></p>
                            <ul class="space-y-3 mb-6">
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Unlimited Portfolios
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Premium Templates
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Advanced Analytics
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Custom Domain
                                </li>
                            </ul>
                            <button class="w-full px-4 py-2 border border-indigo-600 text-indigo-600 font-medium rounded-lg hover:bg-indigo-50 transition">
                                Upgrade to Pro
                            </button>
                        </div>

                        <!-- Business Plan Card -->
                        <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6">
                            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Business</h4>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white mb-4">$29.99<span class="text-lg font-normal text-gray-600 dark:text-gray-400">/month</span></p>
                            <ul class="space-y-3 mb-6">
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Unlimited Portfolios
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    All Premium Features
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    Priority Support
                                </li>
                                <li class="flex items-center text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                    AI Features
                                </li>
                            </ul>
                            <button class="w-full px-4 py-2 border border-indigo-600 text-indigo-600 font-medium rounded-lg hover:bg-indigo-50 transition">
                                Upgrade to Business
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Billing History -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Billing History</h3>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-gray-200 dark:border-gray-700">
                                    <th class="text-left py-3 px-4 font-medium text-gray-700 dark:text-gray-300">Date</th>
                                    <th class="text-left py-3 px-4 font-medium text-gray-700 dark:text-gray-300">Description</th>
                                    <th class="text-right py-3 px-4 font-medium text-gray-700 dark:text-gray-300">Amount</th>
                                    <th class="text-left py-3 px-4 font-medium text-gray-700 dark:text-gray-300">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                                    <td class="py-3 px-4 text-gray-900 dark:text-gray-300">December 1, 2025</td>
                                    <td class="py-3 px-4 text-gray-900 dark:text-gray-300">Free Plan - Free</td>
                                    <td class="py-3 px-4 text-right text-gray-900 dark:text-gray-300">$0.00</td>
                                    <td class="py-3 px-4"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">Paid</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Payment Methods -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Payment Methods</h3>
                    
                    <p class="text-gray-600 dark:text-gray-400 mb-6">No payment method on file. Add one when you upgrade to a paid plan.</p>
                    
                    <button class="px-6 py-2 border border-indigo-600 text-indigo-600 font-medium rounded-lg hover:bg-indigo-50 transition">
                        <i class="fas fa-plus mr-2"></i>Add Payment Method
                    </button>
                </div>
            </div>
            </div>
        </main>
    </div>
</body>
</html>
