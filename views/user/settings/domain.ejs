<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - <%= appName %></title>
    <%- include('../../layouts/partials/head') %>
</head>
<body class="bg-gray-50 dark:bg-gray-900">
    <%- include('../../layouts/partials/dashboard-header') %>

    <div class="flex">
        <%- include('../../layouts/partials/user-sidebar') %>

        <main class="flex-1 p-8">
            <div class="max-w-4xl mx-auto">
                <!-- Header -->
                <div class="mb-8">
                    <div class="flex items-center space-x-4 mb-4">
                        <a href="/dashboard/settings" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300">
                            <i class="fas fa-arrow-left"></i>
                        </a>
                        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Custom Domain</h1>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400">Connect your own domain to your portfolio</p>
                </div>

                <%- include('../../layouts/partials/flash') %>

                <!-- Domain Setup -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Add Your Domain</h3>
                    
                    <form method="POST" action="/dashboard/settings/domain" class="space-y-6">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Domain Name</label>
                            <div class="flex space-x-2">
                                <input type="text" name="domain" placeholder="example.com" class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                <button type="submit" class="px-6 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition">
                                    Connect Domain
                                </button>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Available in Pro and Business plans</p>
                        </div>
                    </form>
                </div>

                <!-- Connected Domains -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Connected Domains</h3>
                    
                    <p class="text-gray-600 dark:text-gray-400 text-center py-8">
                        <i class="fas fa-folder-open text-3xl text-gray-300 dark:text-gray-600 mb-2 block"></i>
                        No domains connected yet
                    </p>
                </div>

                <!-- DNS Instructions -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">DNS Configuration</h3>
                    
                    <div class="space-y-4">
                        <div class="bg-blue-50 dark:bg-blue-900 border border-blue-200 dark:border-blue-700 rounded-lg p-4">
                            <p class="text-sm text-blue-900 dark:text-blue-100">
                                <i class="fas fa-info-circle mr-2"></i>
                                To connect your domain, you'll need to update your DNS records with your domain registrar.
                            </p>
                        </div>

                        <div class="space-y-3">
                            <div>
                                <p class="font-medium text-gray-900 dark:text-white mb-2">CNAME Record:</p>
                                <code class="block bg-gray-100 dark:bg-gray-700 p-3 rounded text-gray-900 dark:text-white text-sm">
                                    www CNAME aboutdev.com
                                </code>
                            </div>

                            <div>
                                <p class="font-medium text-gray-900 dark:text-white mb-2">A Record:</p>
                                <code class="block bg-gray-100 dark:bg-gray-700 p-3 rounded text-gray-900 dark:text-white text-sm">
                                    @ A 192.0.2.1
                                </code>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
