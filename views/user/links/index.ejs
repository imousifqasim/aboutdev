<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head><%- include('../../layouts/partials/head') %><title>Links - <%= appName %></title></head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
<div class="flex h-screen overflow-hidden">
    <%- include('../../layouts/partials/user-sidebar') %>
    <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../../layouts/partials/dashboard-header', { title: 'Links' }) %>
        <main class="flex-1 overflow-y-auto p-6">
            <%- include('../../layouts/partials/flash') %>
            <div class="max-w-4xl">
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 mb-6">
                    <h3 class="font-semibold mb-4"><i class="fas fa-plus mr-2"></i>Add New Link</h3>
                    <% if (!user.isPremiumUser && links.length >= 5) { %>
                    <p class="text-sm text-amber-600 dark:text-amber-400 mb-4"><i class="fas fa-lock mr-1"></i>Free plan limit reached (5/5). <a href="/dashboard/payments" class="underline">Upgrade to Premium</a> for unlimited links.</p>
                    <% } %>
                    <form method="POST" action="/dashboard/links" class="grid grid-cols-1 md:grid-cols-4 gap-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="text" name="title" placeholder="Link Title" required class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700">
                        <input type="url" name="url" placeholder="https://example.com" required class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700">
                        <select name="icon" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700">
                            <option value="">No Icon</option>
                            <option value="globe">Globe</option><option value="github">GitHub</option><option value="linkedin">LinkedIn</option>
                            <option value="twitter">Twitter</option><option value="instagram">Instagram</option><option value="youtube">YouTube</option>
                            <option value="facebook">Facebook</option><option value="tiktok">TikTok</option><option value="envelope">Email</option>
                        </select>
                        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition" <%= !user.isPremiumUser && links.length >= 5 ? 'disabled' : '' %>>
                            <i class="fas fa-plus mr-1"></i>Add
                        </button>
                    </form>
                </div>
                <div class="space-y-3">
                    <% links.forEach(function(link) { %>
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 flex items-center justify-between">
                        <div class="flex items-center space-x-3 flex-1">
                            <i class="fas fa-grip-vertical text-gray-400 cursor-move"></i>
                            <% if (link.icon) { %>
                            <i class="<%= ['github','linkedin','twitter','instagram','youtube','facebook','tiktok'].includes(link.icon) ? 'fab' : 'fas' %> fa-<%= link.icon %> text-lg text-gray-600 dark:text-gray-400"></i>
                            <% } else { %>
                            <i class="fas fa-link text-lg text-gray-600 dark:text-gray-400"></i>
                            <% } %>
                            <div class="flex-1">
                                <p class="font-medium"><%= link.title %></p>
                                <p class="text-sm text-gray-500 truncate"><%= link.url %></p>
                            </div>
                            <span class="text-sm text-gray-500 mr-4"><i class="fas fa-mouse-pointer mr-1"></i><%= link.clicks %> clicks</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <form method="POST" action="/dashboard/links/<%= link.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="px-3 py-1 rounded text-sm <%= link.isActive ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-400' : 'bg-gray-100 text-gray-500 dark:bg-gray-700 dark:text-gray-400' %>">
                                    <i class="fas fa-<%= link.isActive ? 'eye' : 'eye-slash' %>"></i>
                                </button>
                            </form>
                            <form method="POST" action="/dashboard/links/<%= link.id %>/delete" onsubmit="return confirm('Delete this link?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="px-3 py-1 rounded text-sm bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-400"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% if (links.length === 0) { %>
                <div class="text-center py-12 text-gray-500 dark:text-gray-400"><i class="fas fa-link text-4xl mb-4 block"></i><p>No links yet. Add your first link above!</p></div>
                <% } %>
            </div>
        </main>
    </div>
</div>
</body>
</html>
