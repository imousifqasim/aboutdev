<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true', sidebarOpen: false }" :class="{ 'dark': darkMode }">
<head><%- include('../../layouts/partials/head') %><title>Subscription - <%= appName %></title></head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
<div class="flex h-screen overflow-hidden">
    <%- include('../../layouts/partials/user-sidebar') %>
    <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../../layouts/partials/dashboard-header', { title: 'Subscription' }) %>
        <main class="flex-1 overflow-y-auto p-6">
            <%- include('../../layouts/partials/flash') %>
            <div class="max-w-4xl">
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="font-semibold text-lg">Current Plan</h3>
                            <p class="mt-1">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= user.isPremiumUser ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300' : 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300' %>">
                                    <% if (user.isPremiumUser) { %><i class="fas fa-crown mr-1"></i>Premium<% } else { %>Free<% } %>
                                </span>
                            </p>
                            <% if (activeSubscription && activeSubscription.endDate) { %>
                            <p class="text-sm text-gray-500 mt-2">Active until <%= new Date(activeSubscription.endDate).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) %></p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% if (!user.isPremiumUser) { %>
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 mb-6">
                    <h3 class="font-semibold text-lg mb-4"><i class="fas fa-credit-card mr-2"></i>Upgrade to Premium</h3>
                    <div class="grid md:grid-cols-2 gap-4 mb-6">
                        <% paymentMethods.forEach(function(m) { %>
                        <div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg"><p class="font-medium"><%= m.name %></p><p class="text-sm text-gray-500 dark:text-gray-400"><%= m.details %></p></div>
                        <% }) %>
                    </div>
                    <form method="POST" action="/dashboard/payments" enctype="multipart/form-data" class="space-y-4">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div><label class="block text-sm font-medium mb-1">Payment Method</label>
                                <select name="method" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700">
                                    <% paymentMethods.forEach(function(m) { %><option value="<%= m.value %>"><%= m.name %></option><% }) %>
                                </select>
                            </div>
                            <div><label class="block text-sm font-medium mb-1">Amount</label><input type="number" name="amount" step="0.01" min="1" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700"></div>
                        </div>
                        <div><label class="block text-sm font-medium mb-1">Transaction ID</label><input type="text" name="transaction_id" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700"></div>
                        <div><label class="block text-sm font-medium mb-1">Screenshot</label><input type="file" name="screenshot" accept="image/*" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700"></div>
                        <button type="submit" class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-semibold"><i class="fas fa-paper-plane mr-2"></i>Submit Payment</button>
                    </form>
                </div>
                <% } %>

                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                    <h3 class="font-semibold text-lg mb-4"><i class="fas fa-history mr-2"></i>Payment History</h3>
                    <% if (payments.length === 0) { %>
                    <p class="text-gray-500 dark:text-gray-400 text-center py-8">No payments yet.</p>
                    <% } else { %>
                    <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b dark:border-gray-700"><th class="text-left py-3 px-2">Method</th><th class="text-left py-3 px-2">Amount</th><th class="text-left py-3 px-2">Transaction ID</th><th class="text-left py-3 px-2">Status</th><th class="text-left py-3 px-2">Date</th></tr></thead><tbody>
                    <% payments.forEach(function(p) { %>
                    <tr class="border-b dark:border-gray-700">
                        <td class="py-3 px-2"><%= p.method %></td>
                        <td class="py-3 px-2">$<%= parseFloat(p.amount).toFixed(2) %></td>
                        <td class="py-3 px-2 font-mono text-xs"><%= p.transactionId %></td>
                        <td class="py-3 px-2"><span class="px-2 py-1 rounded-full text-xs font-medium <%= p.status === 'approved' ? 'bg-green-100 text-green-800' : p.status === 'rejected' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>"><%= p.status.charAt(0).toUpperCase() + p.status.slice(1) %></span></td>
                        <td class="py-3 px-2"><%= new Date(p.createdAt).toLocaleDateString() %></td>
                    </tr>
                    <% }) %>
                    </tbody></table></div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>
</div>
</body>
</html>
