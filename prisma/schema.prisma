generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  name             String
  email            String           @unique
  password         String?
  role             String           @default("user")
  isBanned         Boolean          @default(false) @map("is_banned")
  emailVerifiedAt  DateTime?        @map("email_verified_at")
  rememberToken    String?          @map("remember_token")
  resetToken       String?          @map("reset_token")
  resetTokenExpires DateTime?       @map("reset_token_expires")
  twoFactorSecret  String?          @map("two_factor_secret")
  twoFactorEnabled Boolean          @default(false) @map("two_factor_enabled")
  googleId         String?          @unique @map("google_id")
  githubId         String?          @unique @map("github_id")
  provider         String           @default("local") // local, google, github
  lastLoginAt      DateTime?        @map("last_login_at")
  loginCount       Int              @default(0) @map("login_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  profile          Profile?
  links            Link[]
  linkCategories   LinkCategory[]
  payments         Payment[]        @relation("UserPayments")
  reviewedPayments Payment[]        @relation("ReviewerPayments")
  subscriptions    Subscription[]
  analytics        Analytic[]
  contactMessages  ContactMessage[]
  loginHistory     LoginHistory[]
  notifications    Notification[]
  mediaFiles       MediaFile[]

  @@map("users")
}

model Profile {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique @map("user_id")
  username              String   @unique
  bio                   String?  @db.Text
  image                 String?
  theme                 String   @default("default")
  isPremium             Boolean  @default(false) @map("is_premium")
  location              String?
  company               String?
  website               String?
  socialLinks           Json?    @map("social_links")
  gallery               Json?
  videos                Json?
  metaTitle             String?  @map("meta_title")
  metaDescription       String?  @map("meta_description") @db.Text
  ogImage               String?  @map("og_image")
  ogTitle               String?  @map("og_title")
  ogDescription         String?  @map("og_description") @db.Text
  focusKeyword          String?  @map("focus_keyword")
  seoSettings           Json?    @map("seo_settings")
  portfolioData         Json?    @map("portfolio_data")
  builderSettings       Json?    @map("builder_settings")
  advancedSeo           Json?    @map("advanced_seo")
  showBranding          Boolean  @default(true) @map("show_branding")
  customDomain          String?  @map("custom_domain")
  spotlightLabel        String?  @map("spotlight_label")
  spotlightUrl          String?  @map("spotlight_url")
  spotlightIcon         String?  @map("spotlight_icon")
  testimonials          Json?
  resume                Json?
  contactFormEnabled    Boolean  @default(false) @map("contact_form_enabled")
  backgroundImage       String?  @map("background_image")
  emailSignatureEnabled Boolean  @default(true) @map("email_signature_enabled")
  pages                 Json?    // Custom pages with text and notes
  integrations          Json?    // Integration settings
  footer                Json?    // Footer content and settings
  defaultTheme          String?  @map("default_theme") // Default theme for new users
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model LinkCategory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  icon      String?  @default("folder")
  color     String?  @default("#4f46e5")
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@unique([userId, name])
  @@map("link_categories")
}

model Link {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  categoryId Int?     @map("category_id")
  title      String
  url        String   @db.VarChar(500)
  icon       String?
  position   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  clicks     Int      @default(0)
  views      Int      @default(0)
  lastClickAt DateTime? @map("last_click_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LinkCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("links")
}

model Payment {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  method         String
  amount         Decimal   @db.Decimal(10, 2)
  transactionId  String    @unique @map("transaction_id")
  screenshotPath String?   @map("screenshot_path")
  status         String    @default("pending")
  adminNote      String?   @map("admin_note") @db.Text
  reviewedBy     Int?      @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User  @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewerPayments", fields: [reviewedBy], references: [id])

  @@map("payments")
}

model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  plan      String    @default("free")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Analytic {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  profileViews    Int      @default(0) @map("profile_views")
  linkClicks      Int      @default(0) @map("link_clicks")
  portfolioViews  Int      @default(0) @map("portfolio_views")
  portfolioClicks Int      @default(0) @map("portfolio_clicks")
  date            DateTime @db.Date
  referrer        String?
  country         String?
  device          String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("analytics")
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  senderName  String   @map("sender_name")
  senderEmail String   @map("sender_email")
  message     String   @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contact_messages")
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent")
  location  String?
  device    String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   // follower, message, view, system
  title     String
  message   String   @db.Text
  data      Json?    // Additional data for the notification
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PortfolioTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  category    String
  content     Json     // Template structure
  preview     String?  // Preview image URL
  isPremium   Boolean  @default(false) @map("is_premium")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("portfolio_templates")
}

model PortfolioSection {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   @unique
  component   String   // React/Vue component name
  settings    Json?    // Default settings
  isPremium   Boolean  @default(false) @map("is_premium")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("portfolio_sections")
}

model MediaFile {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  filename    String
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  size        Int
  path        String
  url         String
  type        String   // image, video, document
  folder      String   @default("general")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media_files")
}

model SubscriptionPlan {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  interval    String   // monthly, yearly
  features    Json     // Feature limits and permissions
  isActive    Boolean  @default(true) @map("is_active")
  stripeId    String?  @map("stripe_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
